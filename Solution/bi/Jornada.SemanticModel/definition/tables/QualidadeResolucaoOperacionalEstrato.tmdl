table QualidadeResolucaoOperacionalEstrato

	measure 'Avaliações de resolução - Estrato' = SUM(QualidadeResolucaoOperacionalEstrato[avaliados])
		formatString: #,##0

	measure 'Resolvidos - Estrato' = SUM(QualidadeResolucaoOperacionalEstrato[resolvidos])
		formatString: #,##0

	measure 'Conflitos - Estrato' = SUM(QualidadeResolucaoOperacionalEstrato[conflitos])
		formatString: #,##0

	measure 'Não resolvidos - Estrato' = SUM(QualidadeResolucaoOperacionalEstrato[nao_resolvidos])
		formatString: #,##0

	measure 'Taxa de resolução - Estrato' = DIVIDE(SUM(QualidadeResolucaoOperacionalEstrato[resolvidos]),SUM(QualidadeResolucaoOperacionalEstrato[avaliados]))
		formatString: 0.00%

	measure 'Proporção de conflito - Estrato' = DIVIDE(SUM(QualidadeResolucaoOperacionalEstrato[conflitos]),SUM(QualidadeResolucaoOperacionalEstrato[avaliados]))
		formatString: 0.00%

	measure 'Proporção de não resolvido - Estrato' = DIVIDE(SUM(QualidadeResolucaoOperacionalEstrato[nao_resolvidos]),SUM(QualidadeResolucaoOperacionalEstrato[avaliados]))
		formatString: 0.00%

	column linkage_run_id
		dataType: string
		summarizeBy: none
		sourceColumn: linkage_run_id

	column modelo_id
		dataType: string
		summarizeBy: none
		sourceColumn: modelo_id

	column modelo_versao
		dataType: int64
		summarizeBy: none
		sourceColumn: modelo_versao

	column algoritmo_versao
		dataType: string
		summarizeBy: none
		sourceColumn: algoritmo_versao

	column tipo_run
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_run

	column status_run
		dataType: string
		summarizeBy: none
		sourceColumn: status_run

	column iniciado_em
		dataType: dateTime
		summarizeBy: none
		sourceColumn: iniciado_em

	column finalizado_em
		dataType: dateTime
		summarizeBy: none
		sourceColumn: finalizado_em

	column estrato_identificacao
		dataType: string
		summarizeBy: none
		sourceColumn: estrato_identificacao

	column avaliados
		dataType: int64
		summarizeBy: sum
		sourceColumn: avaliados

	column resolvidos
		dataType: int64
		summarizeBy: sum
		sourceColumn: resolvidos

	column nao_resolvidos
		dataType: int64
		summarizeBy: sum
		sourceColumn: nao_resolvidos

	column conflitos
		dataType: int64
		summarizeBy: sum
		sourceColumn: conflitos

	column sem_candidato_no_bloco
		dataType: int64
		summarizeBy: sum
		sourceColumn: sem_candidato_no_bloco

	column taxa_resolucao
		dataType: decimal
		summarizeBy: none
		sourceColumn: taxa_resolucao

	column proporcao_conflito
		dataType: decimal
		summarizeBy: none
		sourceColumn: proporcao_conflito

	column proporcao_nao_resolvido
		dataType: decimal
		summarizeBy: none
		sourceColumn: proporcao_nao_resolvido

	column classe_metrica
		dataType: string
		summarizeBy: none
		sourceColumn: classe_metrica

	partition QualidadeResolucaoOperacionalEstrato = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServer, SqlDatabase),
				Data = Source{[Schema="serving", Item="v_bi_qualidade_resolucao_operacional_estrato"]}[Data]
			in
				Data
