table PossibilidadesPessoas

	measure 'Pessoas com Possibilidade' = MAX(PossibilidadesPessoas[pessoas])
		formatString: #,##0

	column pessoas
		dataType: int64
		summarizeBy: none
		sourceColumn: pessoas

	partition PossibilidadesPessoas = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServer, SqlDatabase),
				Data = Source{[Schema="serving", Item="v_bi_possibilidades_pessoas"]}[Data]
			in
				Data
