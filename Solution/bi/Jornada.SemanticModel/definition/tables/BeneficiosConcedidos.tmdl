	partition BeneficiosConcedidos = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServer, SqlDatabase),
				Data = Source{[Schema="serving", Item="v_bi_beneficios_concedidos"]}[Data]
			in
				Data
