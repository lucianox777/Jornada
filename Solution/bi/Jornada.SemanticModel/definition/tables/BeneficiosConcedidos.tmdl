table BeneficiosConcedidos

	measure 'Benefícios Concedidos' = COUNTROWS(BeneficiosConcedidos)
		formatString: #,##0

	measure 'Benefícios pendentes/conflitantes' = CALCULATE(COUNTROWS(BeneficiosConcedidos),BeneficiosConcedidos[estado_atribuicao_identidade]<>"ATRIBUIDA")
		formatString: #,##0

	measure 'Valor pendente/conflitante' = CALCULATE(SUM(BeneficiosConcedidos[valor_concedido]),BeneficiosConcedidos[estado_atribuicao_identidade]<>"ATRIBUIDA")
		formatString: R$ #,##0.00

	measure 'Aviso Fatos e Pessoas' = "Fatos contabilizam todas as ocorrências vigentes declaradas pelos Gestores. Indicadores de Pessoas consideram somente fatos com identidade canônica atribuída."

	measure 'Aviso Monetário' = "Não representa pagamento ocorrido, despesa orçamentária ou desembolso. Fatos incluem ocorrências pendentes/conflitantes de identidade; indicadores de Pessoas usam somente fatos atribuídos."

	measure 'Tipos de Benefício' = DISTINCTCOUNT(BeneficiosConcedidos[beneficio])
		formatString: #,##0

	measure 'Gestores' = DISTINCTCOUNT(BeneficiosConcedidos[gestor])
		formatString: #,##0

	measure 'Soma Valores Concedidos' = SUM(BeneficiosConcedidos[valor_concedido])
		formatString: R$ #,##0.00

	column beneficio_observacao_id
		dataType: int64
		summarizeBy: none
		sourceColumn: beneficio_observacao_id

	column gestor
		dataType: string
		summarizeBy: none
		sourceColumn: gestor

	column beneficio
