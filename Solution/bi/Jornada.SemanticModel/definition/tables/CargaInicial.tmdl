table CargaInicial

	measure 'Pessoas Processadas' = SUM(CargaInicial[pessoas_processadas])
		formatString: #,##0

	measure 'Pessoas por Hora' = MAX(CargaInicial[pessoas_por_hora])
		formatString: #,##0.00

	column hora_utc
		dataType: dateTime
		summarizeBy: none
		sourceColumn: hora_utc

	column pessoas_processadas
		dataType: int64
		summarizeBy: sum
		sourceColumn: pessoas_processadas

	column pessoas_por_hora
		dataType: decimal
		summarizeBy: none
		sourceColumn: pessoas_por_hora

	partition CargaInicial = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServer, SqlDatabase),
				Data = Source{[Schema="serving", Item="v_bi_vazao_ingestao"]}[Data]
			in
				Data
