table QualidadeIdentidadeOrigem

	measure 'Pessoas Observadas' = COUNTROWS(QualidadeIdentidadeOrigem)
		formatString: #,##0
	measure 'Cobertura CPF' = DIVIDE(SUM(QualidadeIdentidadeOrigem[cpf_preenchido]),COUNTROWS(QualidadeIdentidadeOrigem))
		formatString: 0.0%
	measure 'Cobertura UUID - Identidade por Origem' = DIVIDE(SUM(QualidadeIdentidadeOrigem[possui_uuid]),COUNTROWS(QualidadeIdentidadeOrigem))
		formatString: 0.0%
	measure 'Taxa Sem Candidato no Bloco' = DIVIDE(SUM(QualidadeIdentidadeOrigem[sem_candidato_no_bloco]),CALCULATE(COUNTROWS(QualidadeIdentidadeOrigem),QualidadeIdentidadeOrigem[metodo_resolucao]="LINKAGE_PROBABILISTICO" || QualidadeIdentidadeOrigem[metodo_resolucao]="PENDENTE_PROBABILISTICO"))
		formatString: 0.0%
	measure 'Conflitos - Identidade por Origem' = SUM(QualidadeIdentidadeOrigem[conflito])
		formatString: #,##0
	measure 'CPFs com problema' = SUM(QualidadeIdentidadeOrigem[cpf_problema])
		formatString: #,##0
	measure 'CPF ausente - QC Identidade' = CALCULATE(COUNTROWS(QualidadeIdentidadeOrigem),QualidadeIdentidadeOrigem[cpf_classificacao]="CPF_AUSENTE")
		formatString: #,##0
	measure 'CPF inválido estrutural' = CALCULATE(COUNTROWS(QualidadeIdentidadeOrigem),QualidadeIdentidadeOrigem[cpf_classificacao]="CPF_ESTRUTURALMENTE_INVALIDO")
		formatString: #,##0
	measure 'CPF em conflito determinístico' = CALCULATE(COUNTROWS(QualidadeIdentidadeOrigem),QualidadeIdentidadeOrigem[cpf_classificacao]="CPF_CONFLITO_DETERMINISTICO")
		formatString: #,##0
	measure 'Duplicação código mesma âncora' = CALCULATE(COUNTROWS(QualidadeIdentidadeOrigem),QualidadeIdentidadeOrigem[cpf_classificacao]="DUPLICACAO_CODIGO_MESMA_ANCORA")
		formatString: #,##0
	measure 'Junção CPFs mesma origem' = CALCULATE(COUNTROWS(QualidadeIdentidadeOrigem),QualidadeIdentidadeOrigem[cpf_classificacao]="JUNCAO_CPFS_MESMA_ORIGEM")
		formatString: #,##0
	measure 'Divergências identidade abertas' = SUM(QualidadeIdentidadeOrigem[divergencia_identidade_aberta])
		formatString: #,##0
	measure 'Nascimento 01/01' = DIVIDE(SUM(QualidadeIdentidadeOrigem[nascimento_0101]),COUNTROWS(QualidadeIdentidadeOrigem))
		formatString: 0.0%
	measure 'Geografia Preenchida' = DIVIDE(SUM(QualidadeIdentidadeOrigem[geografia_preenchida]),COUNTROWS(QualidadeIdentidadeOrigem))
		formatString: 0.0%

	column pessoa_observacao_id
		dataType: int64
		summarizeBy: none
		sourceColumn: pessoa_observacao_id
