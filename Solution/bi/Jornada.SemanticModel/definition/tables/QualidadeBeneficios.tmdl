	partition QualidadeBeneficios = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServer, SqlDatabase),
				Data = Source{[Schema="serving", Item="v_bi_qualidade_beneficios_concedidos"]}[Data]
			in
				Data
