table QualidadeBeneficios

	measure 'Registros' = COUNTROWS(QualidadeBeneficios)
		formatString: #,##0

	measure 'Entrega Completa %' = DIVIDE(SUM(QualidadeBeneficios[entrega_completa]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Geografia %' = DIVIDE(SUM(QualidadeBeneficios[geografia_preenchida]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Medida Preenchida %' = DIVIDE(SUM(QualidadeBeneficios[medida_preenchida]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Vigencia Coerente %' = DIVIDE(SUM(QualidadeBeneficios[vigencia_coerente]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Vigencia Conforme Regime %' = DIVIDE(SUM(QualidadeBeneficios[vigencia_conforme_regime]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Concessao na Janela %' = DIVIDE(SUM(QualidadeBeneficios[concessao_na_janela_permitida]),SUM(QualidadeBeneficios[concessao_janela_verificavel]))
		formatString: 0.0%

	measure 'Concessao Janela Verificavel %' = DIVIDE(SUM(QualidadeBeneficios[concessao_janela_verificavel]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'QC Implementado %' = DIVIDE(SUM(QualidadeBeneficios[qc_implementado]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'QC Valido %' = DIVIDE(SUM(QualidadeBeneficios[qc_valido]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'QC Divergente %' = DIVIDE(SUM(QualidadeBeneficios[qc_divergente]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'QC Nao Verificavel %' = DIVIDE(SUM(QualidadeBeneficios[qc_nao_verificavel]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Com Versionamento %' = DIVIDE(SUM(QualidadeBeneficios[possui_versionamento]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	measure 'Retificacao Vigente %' = DIVIDE(SUM(QualidadeBeneficios[retificacao_vigente]),COUNTROWS(QualidadeBeneficios))
		formatString: 0.0%

	column registro_observacao_id
