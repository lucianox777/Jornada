table RegistrosPessoas

	measure 'Pessoas com Registros' = MAX(RegistrosPessoas[pessoas])
		formatString: #,##0

	column pessoas
		dataType: int64
		summarizeBy: none
		sourceColumn: pessoas

	partition RegistrosPessoas = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServer, SqlDatabase),
				Data = Source{[Schema="serving", Item="v_bi_registros_pessoas"]}[Data]
			in
				Data
