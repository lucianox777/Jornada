		summarizeBy: none
		sourceColumn: contexto_entrega
	column codigo_tipo
		dataType: string
		summarizeBy: none
		sourceColumn: codigo_tipo
	column nome_tipo
		dataType: string
		summarizeBy: none
		sourceColumn: nome_tipo
	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status
	column data_referencia
		dataType: dateTime
		summarizeBy: none
		sourceColumn: data_referencia
	column recebido_em
		dataType: dateTime
		summarizeBy: none
		sourceColumn: recebido_em
	column bytes_recebidos
		dataType: int64
		summarizeBy: sum
		sourceColumn: bytes_recebidos
	column entrega_completa
