table QualidadeEnvios

	measure 'Entregas Recebidas' = COUNTROWS(QualidadeEnvios)
		formatString: #,##0

	measure 'Taxa Processada' = DIVIDE(SUM(QualidadeEnvios[processada]),COUNTROWS(QualidadeEnvios))
		formatString: 0.0%

	measure 'Itens Recebidos' = SUM(QualidadeEnvios[itens_recebidos])
		formatString: #,##0

	measure 'Pessoas Recebidas' = SUM(QualidadeEnvios[pessoas_recebidas])
		formatString: #,##0

	measure 'Registros Recebidos' = SUM(QualidadeEnvios[registros_recebidos])
		formatString: #,##0

	measure 'Retransmissoes Identicas' = SUM(QualidadeEnvios[retransmitidos])
		formatString: #,##0

	measure 'Taxa Retransmissao' = DIVIDE(SUM(QualidadeEnvios[retransmitidos]),SUM(QualidadeEnvios[itens_recebidos]))
		formatString: 0.0%

	measure 'Entregas com Falha' = SUM(QualidadeEnvios[com_falha])
		formatString: #,##0

	measure 'Zero Fatos no Periodo' = SUM(QualidadeEnvios[zero_fatos_no_periodo])
		formatString: #,##0

	measure 'Tentativas Processor' = SUM(QualidadeEnvios[tentativas_processamento])
		formatString: #,##0

	measure 'Recuperacoes Lease' = SUM(QualidadeEnvios[recuperacoes_lease])
		formatString: #,##0

	measure 'Lotes Poison' = SUM(QualidadeEnvios[lotes_poison])
		formatString: #,##0

	column entrega_id
		dataType: string
		summarizeBy: none
		sourceColumn: entrega_id
	column gestor
		dataType: string
		summarizeBy: none
		sourceColumn: gestor
	column sistema_origem
		dataType: string
		summarizeBy: none
		sourceColumn: sistema_origem
	column natureza
