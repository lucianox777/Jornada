		summarizeBy: none
		sourceColumn: entrega_completa
	column processada
		dataType: int64
		summarizeBy: sum
		sourceColumn: processada
	column com_falha
		dataType: int64
		summarizeBy: sum
		sourceColumn: com_falha
	column itens_recebidos
		dataType: int64
		summarizeBy: sum
		sourceColumn: itens_recebidos
	column pessoas_recebidas
		dataType: int64
		summarizeBy: sum
		sourceColumn: pessoas_recebidas
	column registros_recebidos
		dataType: int64
		summarizeBy: sum
		sourceColumn: registros_recebidos
	column retransmitidos
		dataType: int64
		summarizeBy: sum
