{
  "schemaVersion": 1,
  "status": "VIGENTE",
  "note": "Matriz técnica de autorização. Não cria escopos institucionais; prova coerência entre endpoints, permission strings e tipos de credencial.",
  "credentials": {
    "GESTOR": {
      "resourceOwnership": false
    },
    "BENEFICIO": {
      "resourceOwnership": true
    },
    "SERVICO": {
      "resourceOwnership": true
    }
  },
  "permissions": [
    {
      "permission": "jornada.identidade.resolve",
      "gestor": true,
      "beneficio": true,
      "servico": true
    },
    {
      "permission": "jornada.ingestao.write",
      "gestor": true,
      "beneficio": true,
      "servico": true,
      "resourceOwnershipAlways": true
    },
    {
      "permission": "jornada.ingestao.status",
      "gestor": true,
      "beneficio": true,
      "servico": true,
      "resourceOwnershipAlways": true
    },
    {
      "permission": "jornada.identidade.conflitos.read",
      "gestor": true,
      "beneficio": false,
      "servico": false
    },
    {
      "permission": "jornada.identidade.corrigir",
      "gestor": true,
      "beneficio": false,
      "servico": false
    },
    {
      "permission": "jornada.pessoas.read",
      "gestor": true,
      "beneficio": true,
      "servico": true
    },
    {
      "permission": "jornada.registros.read",
      "gestor": true,
      "beneficio": true,
      "servico": true
    },
    {
      "permission": "jornada.possibilidades.read",
      "gestor": true,
      "beneficio": true,
      "servico": true
    }
  ],
