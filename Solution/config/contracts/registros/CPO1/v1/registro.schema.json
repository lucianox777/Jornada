{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "idPessoaEntrega",
    "codigoRegistroOrigem",
    "operacao",
    "dataHoraServico"
  ],
  "properties": {
    "codigoRegistroOrigem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "operacao": {
      "type": "string",
      "enum": [
        "INCLUSAO",
        "ALTERACAO",
        "RETIFICACAO",
        "EXCLUSAO"
      ]
    },
    "dataHoraServico": {
      "type": "string",
      "format": "date-time"
    },
    "unidadeServico": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "situacao": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "idPessoaEntrega": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Referência obrigatória à idPessoaEntrega de uma linha de pessoas.jsonl na mesma Entrega."
    }
  },
  "additionalProperties": false,
  "$id": "https://jornada.pmspsp.local/contracts/registros/CPO1/v1/registro.schema.json"
}
