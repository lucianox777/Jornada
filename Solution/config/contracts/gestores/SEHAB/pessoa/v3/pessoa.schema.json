{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cpf",
    "nomeCompleto",
    "dataNascimento"
  ],
  "properties": {
    "codigoPessoaOrigem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Opcional quando cpf estiver preenchido. Se ausente, a Jornada usa o CPF de 11 dígitos como codigoPessoaOrigem interno."
    },
    "cpf": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{11}$"
    },
    "cpfAusenteMotivo": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SEM_CPF",
        "EM_REGULARIZACAO",
        "NAO_INFORMADO_ORIGEM",
        null
      ]
    },
    "nomeCompleto": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "dataNascimento": {
      "type": "string",
      "format": "date"
    },
    "nomeMae": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500,
      "description": "Opcional. Ausência não invalida a observação e representa evidência indisponível para linkage."
    },
    "atributosTransversais": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "atributoCodigo",
          "statusEvidencia"
        ],
        "properties": {
          "sourceRecordId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "atributoCodigo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "valor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "statusEvidencia": {
            "type": "string",
            "enum": [
              "DECLARADO",
              "COMPROVADO"
            ]
          },
          "evidenciaTipo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "referenciaEvidencia": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "verificadoEm": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "atualizadoEmOrigem": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "geografia": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "distritoCodigo",
              "distritoNome",
              "subprefeituraCodigo",
              "subprefeituraNome",
              "referenciaMalha"
            ],
            "properties": {
              "distritoCodigo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "distritoNome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "subprefeituraCodigo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "subprefeituraNome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "referenciaMalha": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "additionalProperties": false
          },
          "naturezaReferenciaTerritorial": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "DOMICILIAR",
              "ACOLHIMENTO_INSTITUCIONAL",
              "REFERENCIA_TERRITORIAL_DECLARADA",
              null
            ]
          },
          "situacaoGeografia": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "RESOLVIDA",
              "FORA_MUNICIPIO",
              "SEM_ENDERECO_APTO",
              "NAO_RESOLVIDA_ORIGEM",
              null
            ],
            "description": "Obrigatória para ENDERECO_RESIDENCIAL/REFERENCIA_TERRITORIAL na Fase 1; responsabilidade do Gestor."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "statusEvidencia": {
                  "const": "COMPROVADO"
                }
              },
              "required": [
                "statusEvidencia"
              ]
            },
            "then": {
              "required": [
                "verificadoEm"
              ],
              "properties": {
                "verificadoEm": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "geografia"
              ],
              "properties": {
                "geografia": {
                  "type": "object"
                }
              }
            },
            "then": {
              "properties": {
                "atributoCodigo": {
                  "type": "string",
                  "enum": [
                    "ENDERECO_RESIDENCIAL",
                    "REFERENCIA_TERRITORIAL"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "atributoCodigo": {
                  "const": "REFERENCIA_TERRITORIAL"
                }
              },
              "required": [
                "atributoCodigo"
              ]
            },
            "then": {
              "required": [
                "naturezaReferenciaTerritorial"
              ],
              "properties": {
                "naturezaReferenciaTerritorial": {
                  "type": "string",
                  "enum": [
                    "DOMICILIAR",
                    "ACOLHIMENTO_INSTITUCIONAL",
                    "REFERENCIA_TERRITORIAL_DECLARADA"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "atributoCodigo": {
                  "enum": [
                    "ENDERECO_RESIDENCIAL",
                    "REFERENCIA_TERRITORIAL"
                  ]
                }
              },
              "required": [
                "atributoCodigo"
              ]
            },
            "then": {
              "required": [
                "situacaoGeografia"
              ]
            },
            "else": {
              "properties": {
                "situacaoGeografia": {
                  "type": "null"
                },
                "geografia": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "situacaoGeografia": {
                  "const": "RESOLVIDA"
                }
              },
              "required": [
                "situacaoGeografia"
              ]
            },
            "then": {
              "required": [
                "geografia"
              ]
            },
            "else": {
              "properties": {
                "geografia": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "sourceTransactionId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "conferenciasDocumentais": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "campoCodigo",
          "evidenciaTipo",
          "verificadoEm"
        ],
        "properties": {
          "campoCodigo": {
            "type": "string",
            "enum": [
              "CPF",
              "NOME_COMPLETO",
              "DATA_NASCIMENTO",
              "NOME_MAE"
            ]
          },
          "evidenciaTipo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "referenciaEvidencia": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "verificadoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cpf": {
            "type": "null"
          }
        },
        "required": [
          "cpf"
        ]
      },
      "then": {
        "required": [
          "cpfAusenteMotivo"
        ],
        "properties": {
          "cpfAusenteMotivo": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "cpfAusenteMotivo": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "codigoPessoaOrigem"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "cpf"
        ],
        "properties": {
          "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
