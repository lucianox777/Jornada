  "sql": {
    "mode": "External",
    "connectionString": "Server=sqlserver,1433;Database=JornadaLocal;User Id=sa;Password=Jornada_Local_2026!ChangeMe;TrustServerCertificate=true;Encrypt=false",
    "initializeDatabase": false,
    "setupExe": "",
    "edition": "Standard",
    "instanceName": "MSSQLSERVER",
    "sqlSysAdminAccounts": [
      "BUILTIN\\Administrators"
    ],
    "productKeyEnvironmentVariable": "",
    "userDataDirectory": "",
    "userLogDirectory": "",
    "tempDbDirectory": "",
    "backupDirectory": ""
  },
  "http": {
    "apiUrls": "http://0.0.0.0:5080",
    "resultadoUrls": "http://0.0.0.0:5081",
