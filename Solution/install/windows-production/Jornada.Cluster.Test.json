{
  "schemaVersion": 1,
  "configurationBundleVersion": "3.70-config.1",
  "solutionSchema": "3.70",
  "environment": "Test",
  "installationRoot": "/opt/jornada",
  "nodes": [
    {
      "id": "NODE1",
      "host": "jornada-node1",
      "dataRoot": "/data/node",
      "stagingRoot": "/data/staging",
      "logsRoot": "/data/logs"
    },
    {
      "id": "NODE2",
      "host": "jornada-node2",
      "dataRoot": "/data/node",
      "stagingRoot": "/data/staging",
      "logsRoot": "/data/logs"
    }
  ],
  "storage": {
    "bronzeRoot": "/data/bronze"
  },
  "dotnet": {
    "installIfMissing": false,
    "hostingBundleUrl": "https://aka.ms/dotnet/8.0/dotnet-hosting-win.exe"
  },
  "docker": {
    "mode": "None",
    "mobyInstallScriptUrl": "https://raw.githubusercontent.com/microsoft/Windows-Containers/Main/helpful_tools/Install-DockerCE/install-docker-ce.ps1",
    "mobyInstallScriptSha256": "CHANGE_ME_WITH_APPROVED_SHA256"
  },
  "sql": {
    "mode": "External",
    "connectionString": "Server=sqlserver,1433;Database=JornadaLocal;User Id=sa;Password=${JORNADA_SQL_SA_PASSWORD};TrustServerCertificate=true;Encrypt=false",
    "initializeDatabase": false,
    "setupExe": "",
    "edition": "Standard",
    "instanceName": "MSSQLSERVER",
    "sqlSysAdminAccounts": ["BUILTIN\\Administrators"],
    "productKeyEnvironmentVariable": "",
    "userDataDirectory": "",
    "userLogDirectory": "",
    "tempDbDirectory": "",
    "backupDirectory": ""
  },
  "http": {
    "apiUrls": "http://0.0.0.0:5080",
    "resultadoUrls": "http://0.0.0.0:5081",
    "jornadaApiBaseUrl": "http://127.0.0.1:5080"
  },
  "runtime": {
    "environment": {
      "Processor__PollingMilliseconds": "1000"
    }
  },
  "integrator": {
    "enabled": false,
    "gestor": "SEHAB",
    "accessKey": "KcUBZuLvRCu0lKN6xmXdjGKhPTgluG1Wu0sFB36lvTY",
    "endpoints": {
      "envio": "http://127.0.0.1:5080/api/v1/ingestao/entregas",
      "resultado": "http://127.0.0.1:5081/api/v1/ingestao/resultados/{nomeArquivo}"
    },
    "polling": {"intervalSeconds": 5, "timeoutSeconds": 3600},
    "diretorioSaida": "resultados"
  },
  "taskAccount": {"user": "SYSTEM", "passwordEnvironmentVariable": ""},
  "tasks": [
    {"name":"Jornada-Api","enabled":true,"component":"Api","trigger":{"type":"AtStartup"},"arguments":[],"environment":{}},
    {"name":"Jornada-ResultadoApi","enabled":true,"component":"ResultadoApi","trigger":{"type":"AtStartup"},"arguments":[],"environment":{}},
    {"name":"Jornada-Processor","enabled":true,"component":"Processor","trigger":{"type":"AtStartup"},"arguments":[],"environment":{}},
    {"name":"Jornada-OperationsMaintenance","enabled":true,"component":"OperationsMaintenance","trigger":{"type":"AtStartup"},"arguments":[],"environment":{}},
    {"name":"Jornada-BronzeMaintenance","enabled":true,"component":"BronzeMaintenance","trigger":{"type":"AtStartup"},"arguments":[],"environment":{}}
  ]
