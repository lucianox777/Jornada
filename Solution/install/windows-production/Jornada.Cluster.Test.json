  "runtime": {
    "environment": {
      "Processor__PollingMilliseconds": "1000"
    }
  },
  "integrator": {
    "enabled": false,
    "gestor": "SEHAB",
    "accessKey": "KcUBZuLvRCu0lKN6xmXdjGKhPTgluG1Wu0sFB36lvTY",
    "endpoints": {
      "envio": "http://127.0.0.1:5080/api/v1/ingestao/entregas",
      "resultado": "http://127.0.0.1:5081/api/v1/ingestao/resultados/{nomeArquivo}"
    },
    "polling": {
      "intervalSeconds": 5,
      "timeoutSeconds": 3600
    },
    "diretorioSaida": "resultados"
  },
  "taskAccount": {
    "user": "SYSTEM",
    "passwordEnvironmentVariable": ""
  },
  "tasks": [
    {
      "name": "Jornada-Api",
      "enabled": true,
      "component": "Api",
      "trigger": {
        "type": "AtStartup"
      },
      "arguments": [],
      "environment": {}
    },
    {
      "name": "Jornada-ResultadoApi",
      "enabled": true,
      "component": "ResultadoApi",
      "trigger": {
        "type": "AtStartup"
      },
      "arguments": [],
      "environment": {}
    },
    {
      "name": "Jornada-Processor",
      "enabled": true,
      "component": "Processor",
      "trigger": {
        "type": "AtStartup"
      },
      "arguments": [],
      "environment": {}
    },
    {
      "name": "Jornada-OperationsMaintenance",
      "enabled": true,
      "component": "OperationsMaintenance",
      "trigger": {
        "type": "AtStartup"
      },
      "arguments": [],
      "environment": {}
    },
    {
      "name": "Jornada-BronzeMaintenance",
      "enabled": true,
      "component": "BronzeMaintenance",
      "trigger": {
        "type": "AtStartup"
      },
      "arguments": [],
      "environment": {}
    },
    {
      "name": "Jornada-Linkage-GenerateDraft",
      "enabled": false,
      "component": "LinkageParameters",
      "trigger": {
        "type": "Weekly",
        "days": [
          "Sunday"
        ],
        "at": "02:00"
      },
      "arguments": [],
      "environment": {
        "LinkageParameters__Operation": "GENERATE_DRAFT",
        "LinkageParameters__RunOnce": "true"
      }
    },
    {
      "name": "Jornada-Linkage-Incremental",
      "enabled": false,
      "component": "LinkageRunner",
      "trigger": {
        "type": "Daily",
        "at": "03:00"
      },
      "arguments": [
        "--mode",
        "INCREMENTAL",
        "--publish",
        "true",
        "--requested-by",
        "SCHEDULED_TASK",
        "--reason",
        "scheduled-run"
      ],
      "environment": {}
    },
    {
      "name": "Jornada-Integrator-EnviarTodos",
      "enabled": false,
      "component": "Integrator",
      "trigger": {
        "type": "Daily",
        "at": "01:00"
      },
      "arguments": [
        "--enviar-todos",
        "--config",
        "integrador.config.json"
      ],
      "environment": {}
    }
  ]
