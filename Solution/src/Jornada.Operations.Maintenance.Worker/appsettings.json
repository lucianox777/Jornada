{
  "ConnectionStrings": {
    "Jornada": "Server=localhost;Database=Jornada;Integrated Security=true;TrustServerCertificate=true"
  },
  "ItemProcessedRetention": {
    "Enabled": false,
    "DetailRetentionDays": 0,
    "MaxRowsPerCycle": 100000,
    "IntervalMinutes": 60
  },
  "BronzeStorage": {
    "Provider": "FileSystem",
    "RootPath": "../../data/bronze"
  },
  "DeliveryBronzeRetention": {
    "Enabled": false,
    "RetentionDays": 0,
    "MaxRowsPerCycle": 500,
    "IntervalMinutes": 60,
    "ObjectLockTimeoutSeconds": 5
  },
  "PipelineWatchdog": {
    "Enabled": false,
    "IntervalMinutes": 5,
    "LinkageRunMaxMinutes": 120,
    "ModelGenerationMaxMinutes": 120,
    "ExpiredLeaseGraceMinutes": 5,
    "PendingBacklogMaxAgeMinutes": 60,
    "InitialLoadMaxHours": 24
  }
}
