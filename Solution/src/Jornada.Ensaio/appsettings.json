{
  "ConnectionStrings": {
    "Jornada": "Server=(localdb)\\MSSQLLocalDB;Database=JornadaDev;Integrated Security=true;TrustServerCertificate=true"
  },
  "Database": { "Provider": "SqlServer" },
  "Ensaio": {
    "PacotesDir": ".",
    "SaidaDir": "./ensaio",
    "Endpoints": {
      "IngestaoEntregas": "http://localhost:8080/api/v1/ingestao/entregas"
    },
    "ApiKey": "",
    "DrenagemTimeoutMinutos": 120,
    "Calibrador": {
      "FileName": "dotnet",
      "Arguments": "run --project ../Jornada.Linkage.Parameters.Worker/Jornada.Linkage.Parameters.Worker.csproj --configuration Release"
    },
    "Runner": {
      "FileName": "dotnet",
      "Arguments": "run --project ../Jornada.Linkage.Runner/Jornada.Linkage.Runner.csproj --configuration Release --",
      "MaxRecords": 100000
    }
  },
  "LinkageParameters": {
    "AlgorithmVersion": "FELLEGI_SUNTER_DECISION_EVIDENCE_V6",
    "NormalizationVersion": "IDENTITY_NORMALIZATION_V1",
    "TrainingSampleSize": 250000,
    "TrainingSamplePoolSize": 1000000,
    "SmoothingAlpha": 0.5,
    "DecisionCalibration": {
      "Seed": 20260919,
      "ValidationBasisPoints": 2000,
      "TestBasisPoints": 2000
    },
    "ReadCommandTimeoutSeconds": 900,
    "MinimumIndependentMatchedPairs": 5000
  }
}
