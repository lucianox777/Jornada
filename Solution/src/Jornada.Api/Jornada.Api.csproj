<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Jornada.Access.Security\Jornada.Access.Security.csproj" />
    <ProjectReference Include="..\Jornada.Operational.Sql\Jornada.Operational.Sql.csproj" />
    <ProjectReference Include="..\Jornada.Bronze.Storage\Jornada.Bronze.Storage.csproj" />
    <ProjectReference Include="..\Jornada.Contracts\Jornada.Contracts.csproj" />
    <ProjectReference Include="..\Jornada.Linkage.Runner\Jornada.Linkage.Runner.csproj" />
    <ProjectReference Include="..\Jornada.Ingestion\Jornada.Ingestion.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>
  <!-- A API reutiliza o assembly do Runner, não seus arquivos de configuração/lock. -->
  <Target Name="ExcludeReferencedRunnerPublishContent" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('Jornada.Linkage.Runner')) And ('%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'packages.lock.json')" />
    </ItemGroup>
  </Target>
</Project>
