{
  "ConnectionStrings": {
    "Jornada": "Server=(localdb)\\MSSQLLocalDB;Database=JornadaDev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "BronzeStorage": {
    "Provider": "FileSystem",
    "RootPath": "data/bronze"
  },
  "ProbabilisticLinkage": {
    "MaxCandidatesPerBlock": 100000,
    "BirthYearTolerance": 1,
    "CommandTimeoutSeconds": 900,
    "FreezeUniverseCommandTimeoutSeconds": 900
  },
  "LinkageReplay": {
    "CaptureBronzeSources": false,
    "CaptureCommandTimeoutSeconds": 3600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PipelineCoordination": {
    "CurrentBatchDrainTimeoutSeconds": 900,
    "HeartbeatSeconds": 5,
    "ExclusiveIntentTimeoutSeconds": 5
  }
}
