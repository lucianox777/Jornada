          "200": {
            "description": "Resposta processada"
          },
          "400": {
            "description": "Requisição inválida"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Não autorizado"
          },
          "429": {
            "description": "Rate limit excedido"
          },
          "500": {
            "description": "Falha interna"
          }
        }
      }
    },
    "/api/v1/ingestao/entregas": {
      "post": {
        "operationId": "jornada_post_05",
        "summary": "Recebe Entrega ZIP",
        "responses": {
          "400": {
            "description": "Requisição inválida"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Não autorizado"
          },
          "429": {
            "description": "Rate limit excedido"
          },
          "500": {
            "description": "Falha interna"
          },
          "202": {
            "description": "Entrega aceita ou replay idempotente da mesma Entrega"
          },
          "413": {
            "description": "ZIP excede 250 MiB compactados"
          },
          "409": {
            "description": "Idempotency-Key já usada para conteúdo diferente"
          },
          "503": {
            "description": "Staging/Bronze temporariamente indisponível"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
