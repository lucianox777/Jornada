  "components": {
    "securitySchemes": {
      "JornadaAccessKey":{"type":"apiKey","in":"header","name":"X-Jornada-Access-Key"},
      "JornadaGestor":{"type":"apiKey","in":"header","name":"X-Jornada-Gestor"},
      "JornadaBeneficio":{"type":"apiKey","in":"header","name":"X-Jornada-Beneficio"},
      "JornadaServico":{"type":"apiKey","in":"header","name":"X-Jornada-Servico"}
    },
    "schemas": {
      "ProgressiveOriginQueryRequest":{"type":"object","required":["codigoSistemaOrigem","codigoPessoaOrigem"],"additionalProperties":false,"properties":{"codigoSistemaOrigem":{"type":"string","minLength":1,"maxLength":80,"description":"Namespace técnico de origem, não o nome de exibição."},"codigoPessoaOrigem":{"type":"string","minLength":1,"maxLength":255,"description":"Chave interna da pessoa no sistema de origem; não é CPF."}}},
      "ProgressiveOriginQueryResponse":{"type":"object","required":["codigoSistemaOrigem","codigoPessoaOrigem","initialUuid","canonicalUuid","estado","versao","criadoEm","atualizadoEm","ultimaResolucaoEm"],"properties":{"codigoSistemaOrigem":{"type":"string"},"codigoPessoaOrigem":{"type":"string"},"initialUuid":{"type":"string","format":"uuid","description":"UUID inicial imutável da identidade de origem."},"canonicalUuid":{"type":"string","format":"uuid","nullable":true,"description":"Referência canônica publicada somente com estado REFERENCIA."},"estado":{"type":"string","enum":["PROVISORIA","REFERENCIA","INDEFINIDA"]},"versao":{"type":"integer","format":"int64","minimum":0},"criadoEm":{"type":"string","format":"date-time"},"atualizadoEm":{"type":"string","format":"date-time"},"ultimaResolucaoEm":{"type":"string","format":"date-time","nullable":true}}}
    }
