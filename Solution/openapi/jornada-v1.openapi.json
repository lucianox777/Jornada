    "/api/v1/identidade/origens/consulta": {
      "post": {
        "operationId":"consultarIdentidadeProgressivaOrigem",
        "summary":"Consultar a referência progressiva de uma identidade de origem",
        "description":"Somente leitura. Exige credencial GESTOR, scope jornada.identidade.origem.read e propriedade do sistema de origem. Não cria nem altera UUIDs.",
        "security":[{"JornadaAccessKey":[],"JornadaGestor":[]}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProgressiveOriginQueryRequest"}}}},
        "responses": {
          "200":{"description":"Referência corrente no escopo do Gestor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProgressiveOriginQueryResponse"}}}},
          "400":{"description":"Corpo ou códigos inválidos."},"401":{"description":"Credencial ausente ou inválida."},
          "403":{"description":"Tipo de credencial ou scope não autorizado."},
          "404":{"description":"Não localizado no escopo do Gestor; não distingue inexistência de falta de propriedade."},
          "429":{"description":"Limite de requisições excedido."},"500":{"description":"Falha interna sem divulgação de dados de origem."},
          "503":{"description":"Schema ou view de identidade progressiva indisponível.","content":{"application/json":{"schema":{"type":"object","properties":{"codigo":{"type":"string","enum":["IDENTIDADE_PROGRESSIVA_INDISPONIVEL"]}}}}}}
        }
      }
    }
